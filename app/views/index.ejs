<%- include('header') %>
<section class="hero text-center text-white py-5"><div class="container py-4">
<h1 class="display-5 fw-bold">Công nghệ đỉnh cao – Giá tốt mỗi ngày</h1>
<p class="lead">Miễn phí vận chuyển toàn quốc · Bảo hành chính hãng</p></div></section>
<div class="container my-5">
<div class="mb-4 d-flex gap-2 flex-wrap">
<a class="btn btn-sm rounded-pill <%= !cat?'btn-dark':'btn-outline-dark' %>" href="/">Tất cả</a>
<% cats.forEach(c=>{ %><a class="btn btn-sm rounded-pill <%= cat===c?'btn-dark':'btn-outline-dark' %>" href="/?cat=<%= encodeURIComponent(c) %>"><%= c %></a><% }) %>
</div>
<div class="row g-4"><% products.forEach(p=>{ %>
<div class="col-6 col-md-3"><div class="card product h-100 border-0 shadow-sm">
<div class="thumb"><%= p.emoji %></div>
<div class="card-body d-flex flex-column">
<span class="badge text-bg-light align-self-start"><%= p.category %></span>
<h6 class="mt-2 fw-bold"><%= p.name %></h6><p class="small text-muted"><%= p.description %></p>
<div class="mt-auto"><div class="price mb-2"><%= vnd(p.price) %></div>
<form method="post" action="/cart/add/<%= p.id %>"><button class="btn btn-primary w-100 rounded-pill">Thêm vào giỏ</button></form>
</div></div></div></div><% }) %></div></div>
<%- include('footer') %>
